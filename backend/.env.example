# Copy to .env and fill in. Never commit the real .env file.

# --- Database ---
DATABASE_URL=postgresql+psycopg2://clipping_machine:clipping_machine@localhost:5432/clipping_machine

# --- Queue ---
REDIS_URL=redis://localhost:6379/0

# --- Object storage ---
# "local" writes to STORAGE_LOCAL_DIR on disk -- fine for dev, not for multi-machine deploys.
# "s3" uses the S3_* settings below (works with AWS S3 or any S3-compatible endpoint, e.g. R2).
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./data/objects

S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
JWT_SECRET=change-me-dev-only
# Local dev only: with this set AND APP_ENV=development, requests with no
# Authorization header are treated as this user (created on first use), so the
# dev console needs no token pasted in. Leave BLANK for anything reachable from
# outside your machine -- creator_accounts holds encrypted TikTok tokens, so an
# unauthenticated API means anyone who can reach the port can post as you.
DEV_AUTO_LOGIN_EMAIL=
# 8 GiB. Streamer VODs routinely exceed the old 2 GiB default -- a 3-6h
# stream is commonly 2-6 GB. Raise further if your source files are bigger;
# the API streams uploads to disk in 1 MiB chunks, so this caps disk use,
# not memory.
MAX_UPLOAD_BYTES=8589934592

# --- Creator account token encryption (see app/core/crypto.py) ---
# Leave blank in dev -- a key gets derived from JWT_SECRET automatically.
# Set a real, dedicated Fernet key (python3 -c "from cryptography.fernet
# import Fernet; print(Fernet.generate_key().decode())") for anything beyond
# local dev, since rotating JWT_SECRET would otherwise also silently break
# decrypting every already-stored creator account token.
CREATOR_ACCOUNT_ENCRYPTION_KEY=

# --- Product limits (hard caps, see architecture doc §5) ---
DEFAULT_MAX_CLIPS_PER_JOB=10
HARD_MAX_CLIPS_PER_JOB=20
DEFAULT_DAILY_UPLOAD_CAP=3
HARD_MAX_DAILY_UPLOAD_CAP=10
UPLOAD_CONFIDENCE_THRESHOLD=0.55

# --- Per-job override bounds (see README's "Per-job options") ---
MIN_CLIP_SECONDS_FLOOR=5
MAX_CLIP_SECONDS_CEILING=180
DEFAULT_MIN_SCORE_THRESHOLD=0

# --- Rendering / vertical crop (see README's "Face-aware crop") ---
# When true (default), rendering samples a few frames per clip and biases
# the 9:16 crop toward a detected face instead of always cropping the
# frame's dead center -- falls back to centered automatically if no face is
# found. Set false to skip the extra per-clip cost for content that never
# has a visible face (e.g. pure gameplay capture, no webcam).
ENABLE_FACE_AWARE_CROP=true

# When true (default) and a detected face looks like a small, corner-
# positioned webcam box rather than someone filling the frame (see
# README's "Reaction split layout"), rendering uses a split layout instead
# of a single crop: top half is a zoomed facecam, bottom half is the full
# frame. Requires ENABLE_FACE_AWARE_CROP=true (no face profile, no
# classification). Set false to always use the single crop.
ENABLE_REACTION_SPLIT_LAYOUT=true

# --- LLM-assisted clip title/hashtags/captions (see README's "Clip hashtags & captions") ---
# Runs synchronously as part of rendering itself (moved there so the
# clickbait "title" field can be burned into the clip -- see
# ENABLE_CLIP_TITLE_OVERLAY below). With this off, or the chosen provider
# unavailable (no key for "openai"; Ollama unreachable for "ollama"), every
# clip still gets a title/hashtags/caption -- just the heuristic template
# versions instead of ones actually grounded in this clip's transcript.
ENABLE_LLM_CAPTIONS=true
# "openai": hosted, needs OPENAI_API_KEY below, costs per call.
# "ollama": free/self-hosted open-weight model, no API key -- run
#   `ollama pull llama3.1:8b && ollama serve` first. Same transcript-grounded
#   prompt either way; only the model backing it changes.
CAPTION_LLM_PROVIDER=openai
CAPTION_LLM_MODEL=gpt-4o-mini
# CAPTION_OLLAMA_MODEL=llama3.1:8b
# CAPTION_OLLAMA_BASE_URL=http://localhost:11434/v1
# Whether the generated title actually gets burned into the top of the
# rendered video (a second subtitles/libass stage, see README's
# "Rendering") -- independent of ENABLE_LLM_CAPTIONS, which only controls
# whether that title text is LLM-written vs. the heuristic fallback. Off
# still generates/stores the title (and hashtags/caption/explanation), it
# just isn't baked into the pixels.
ENABLE_CLIP_TITLE_OVERLAY=true

# --- LLM segment suggestion (app/core/llm_segmentation.py, see README's
# "LLM segment suggestion") ---
# Opt-in, additive candidate proposer for segmentation. Reads a job's
# transcript ONCE and asks the SAME LLM/provider as the caption settings
# above (CAPTION_LLM_PROVIDER/CAPTION_LLM_MODEL/CAPTION_OLLAMA_MODEL/
# CAPTION_OLLAMA_BASE_URL -- no separate provider config needed here) to
# suggest a handful of "this looks like a good clip" windows, referencing
# real transcript segment indices (never raw timestamps) to avoid
# hallucinated numbers. Those suggestions are inserted into the exact same
# pending_score candidate pool as the deterministic sliding-window
# segmentation's output -- this NEVER replaces or ranks candidates itself;
# the existing deterministic scoring + selection picks winners from the
# combined set exactly like it already does today. Off by default -- this
# is a new, unproven signal. Degrades to zero LLM-suggested candidates
# (never fails the segmentation job) if disabled, no API key, unreachable,
# the response is malformed, or the transcript is too long to safely
# prompt with (see LLM_SEGMENT_MAX_TRANSCRIPT_SEGMENTS below).
ENABLE_LLM_SEGMENT_SUGGESTIONS=false
# Hard cap on how many LLM-suggested candidates one job can add.
LLM_SEGMENT_MAX_SUGGESTIONS=8
# Above this many transcript segments, skip the LLM suggestion call
# entirely rather than truncating the transcript (which would bias
# suggestions toward whichever end of the VOD got kept).
LLM_SEGMENT_MAX_TRANSCRIPT_SEGMENTS=800

# --- Audio-event detection (app/core/audio_events.py, see README's
# "Audio-event scoring") ---
# When true, scoring runs an open-source audio classifier (PANNs) over each
# candidate clip's audio to detect laughter/cheering/crowd reaction as an
# extra ranking signal, on top of the existing transcript/scene-cut
# features. Off by default: it pulls in torch + a ~300MB pretrained
# checkpoint (downloaded once, cached in ~/panns_data/) on first scoring job
# after this is turned on -- see requirements.txt's comment on installing
# the CPU-only torch wheel first if you're on a CPU-only machine. Falls
# back to treating both signals as 0 (no effect on scoring) if the model
# fails to load or an audio file can't be read -- never fails a scoring job.
ENABLE_AUDIO_EVENT_SCORING=false
# Only used when the flag above is true. Same "one signal among several"
# scale as SCORE_WEIGHT_SPEECH_DENSITY/SCORE_WEIGHT_QUESTION_MARKS by
# default -- there's no real usage data yet to tune these against.
SCORE_WEIGHT_LAUGHTER=1.0
SCORE_WEIGHT_CROWD_REACTION=1.0

# --- Segmentation (candidate clip windows -- see README) ---
# Lower these for short test videos, or every job will correctly end in
# "no candidate windows found" (no speech block reaches the minimum).
SEGMENT_MIN_CLIP_SECONDS=15
SEGMENT_MAX_CLIP_SECONDS=90
SEGMENT_SILENCE_GAP_SECONDS=1.2
# Analyze only every (this+1)th frame during PySceneDetect's scene-cut pass
# -- segmentation is typically the slowest stage for a long VOD, and this is
# a real decode-cost reduction (see README's "Segmentation" section), not
# just work thrown away. 2 = ~3x less decode work; 0 = every frame (slowest,
# most precise). Raise toward 0 only if scene-cut timestamps need to be
# more exact than +/- a few hundred ms.
SCENE_DETECT_FRAME_SKIP=2

# --- Speech-to-text ---
# "local" (default): open-source faster-whisper, runs on this machine's CPU,
#   no API key, no per-minute cost. Fine for MVP; "base" is sized for CPU
#   throughput -- bump to "small"/"medium" for better accuracy if you have
#   the CPU time to spare, or run on a GPU box and switch device in
#   app/core/stt/local_whisper.py.
# "openai": hosted Whisper API instead -- needs OPENAI_API_KEY, costs
#   per-minute, but offloads compute and tends to be faster wall-clock.
STT_PROVIDER=local
STT_LOCAL_MODEL_SIZE=base
STT_LOCAL_COMPUTE_TYPE=int8
STT_OPENAI_MODEL=whisper-1
STT_OPENAI_CHUNK_SECONDS=600

OPENAI_API_KEY=

# --- TikTok Content Posting API (app/core/tiktok_client.py, app/workers/upload.py) ---
# From a registered TikTok developer app (Content Posting API product,
# Direct Post enabled, video.upload scope) -- see README's TikTok setup
# section. Without these three set, GET .../creator-accounts/tiktok/oauth/start
# returns 503 rather than a broken authorize URL.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Must exactly match one of that app's registered redirect URIs. TikTok
# requires this to be https with no exception for localhost -- confirmed
# against developers.tiktok.com's Login Kit docs, which state "URIs must be
# absolute and begin with https" with no dev-environment carve-out. Since
# this backend runs on http://localhost in dev, testing needs a tunnel
# (e.g. `ngrok http 8000`) pointed at this server; set this to the tunnel's
# https URL + /api/v1/creator-accounts/tiktok/oauth/callback, and register
# that exact same URL in the TikTok developer portal's Login Kit config.
TIKTOK_REDIRECT_URI=
# Tuning knobs, defaults are fine for MVP-sized clips -- see
# app/core/config.py for what each controls.
# TIKTOK_UPLOAD_CHUNK_SIZE_BYTES=10000000
# TIKTOK_STATUS_POLL_INTERVAL_SECONDS=3.0
# TIKTOK_STATUS_POLL_MAX_ATTEMPTS=20
